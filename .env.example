# Local development defaults. Copy to .env and change only when needed.
# Do not commit .env or place credentials in this file in shared repositories.

# Application
APP_NAME=RAGForge
ENVIRONMENT=development

# Ollama local generation
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# FastEmbed embeddings (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_SIZE=384

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ragforge_chunks

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
