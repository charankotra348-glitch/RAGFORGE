# Local development defaults. Copy to .env and change only when needed.
# Do not commit .env or place credentials in this file in shared repositories.

# Application
APP_NAME=RAGForge
ENVIRONMENT=development

# Ollama local generation
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Grounding verifier (second LLM call per answer). Off by default; see core/config.py.
GROUNDING_VERIFIER_ENABLED=false

# FastEmbed embeddings (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_SIZE=384

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ragforge_chunks

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API authentication. Create a key with:
#   uv run python -m ragforge.app.security new-key
# and put the printed hash here (comma-separate several). Never put the key itself in this file.
AUTH_ENABLED=true
API_KEY_HASHES=

# Requests per API key per minute (0 disables).
RATE_LIMIT_PER_MINUTE=30

# Seconds an answer stays in the Redis cache (0 disables).
ANSWER_CACHE_TTL_SECONDS=3600

# Logging: json (one object per line) or text.
LOG_FORMAT=json
LOG_LEVEL=INFO
